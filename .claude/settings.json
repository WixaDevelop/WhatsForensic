{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",

  "permissions": {
    "allow": [
      "Bash(cargo build:*)",
      "Bash(cargo check:*)",
      "Bash(cargo test:*)",
      "Bash(cargo clippy:*)",
      "Bash(cargo fmt:*)",
      "Bash(cargo audit:*)",
      "Bash(cargo tree:*)",
      "Bash(cargo doc:*)",
      "Bash(npm install:*)",
      "Bash(npm run:*)",
      "Bash(npm test:*)",
      "Bash(npm ci:*)",
      "Bash(npx tauri:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git restore:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(find:*)",
      "Bash(wc:*)",
      "Bash(file:*)",
      "Bash(xxd:*)",
      "Bash(sha256sum:*)",
      "Bash(shasum:*)",
      "Read(**)"
    ],

    "deny": [
      "Bash(rm:*)",
      "Bash(rmdir:*)",
      "Bash(mv:*)",
      "Bash(dd:*)",
      "Bash(chmod -R:*)",
      "Bash(curl:* /etc/*)",
      "Bash(wget:*)",
      "Bash(sudo:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -fd:*)",
      "Write(**/*.sqlite)",
      "Write(**/*.sqlite3)",
      "Write(**/*.db)",
      "Write(**/*.db-wal)",
      "Write(**/*.db-shm)",
      "Write(**/*.db-journal)",
      "Write(**/*.storedata)",
      "Write(**/*.crypt12)",
      "Write(**/*.crypt14)",
      "Write(**/*.crypt15)",
      "Write(**/msgstore.db*)",
      "Write(**/ChatStorage.sqlite*)",
      "Write(**/CallHistory.*)",
      "Write(**/Manifest.db*)",
      "Edit(**/*.sqlite)",
      "Edit(**/*.db)",
      "Edit(**/*.db-wal)",
      "Edit(**/*.db-shm)",
      "Edit(**/.env*)",
      "Edit(**/*.key)",
      "Edit(**/*.pem)",
      "Write(workspaces/**)",
      "Write(cases/**)",
      "Edit(workspaces/**)",
      "Edit(cases/**)"
    ],

    "ask": [
      "Bash(git push:*)",
      "Bash(git rebase:*)",
      "Bash(git merge:*)",
      "Bash(cargo install:*)",
      "Bash(npm publish:*)"
    ]
  }
}
